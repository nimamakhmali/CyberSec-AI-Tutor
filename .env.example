# Application
APP_NAME=CyberSec AI Tutor
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text

# Vector Database
VECTOR_DB=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=cybersec_knowledge

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
RETRIEVAL_K=8
FINAL_CONTEXT_K=4
RETRIEVAL_MODE=mmr

# Memory
MEMORY_TURNS=10
ENABLE_SUMMARIZATION=true

# Generation
TEMPERATURE=0.2
MAX_TOKENS=2048

# Security
ENABLE_SAFETY_FILTER=true
MAX_INPUT_LENGTH=4000