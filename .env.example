# Application
APP_NAME=CyberSec AI Tutor
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192

# Vector Database
VECTOR_DB=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=cybersec_knowledge

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
RETRIEVAL_K=8
FINAL_CONTEXT_K=4
RETRIEVAL_MODE=mmr
ENABLE_RERANKING=true

# Memory
MEMORY_TURNS=10
ENABLE_SUMMARIZATION=true
SUMMARY_THRESHOLD=15

# Generation
TEMPERATURE=0.2
MAX_NEW_TOKENS=2048
STREAMING=true

# Security
MAX_INPUT_LENGTH=4000
ENABLE_CONTENT_FILTER=true